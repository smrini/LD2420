{
  "name": "LD2420",
  "version": "0.2.1",
  "description": "Driver for the HLK-LD2420 24GHz presence sensor's plain-text (ON/OFF + Range) UART output. Includes a configurable room-distance cutoff with exit-grace hysteresis, event callbacks (presence/room enter/exit), and automatic baud-rate detection.",
  "keywords": ["sensor", "presence", "radar", "ld2420", "hlk-ld2420", "mmwave"],
  "repository": {
    "type": "git",
    "url": "https://github.com/smrini/LD2420.git"
  },
  "authors": [
    {
      "name": "Said",
      "url": "https://github.com/smrini"
    }
  ],
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": ["espressif32"],
  "headers": "LD2420.h",
  "examples": [
    {
      "name": "BasicRead",
      "base": "examples/BasicRead",
      "files": ["BasicRead.ino"]
    },
    {
      "name": "RoomPresence",
      "base": "examples/RoomPresence",
      "files": ["RoomPresence.ino"]
    },
    {
      "name": "EventCallbacks",
      "base": "examples/EventCallbacks",
      "files": ["EventCallbacks.ino"]
    }
  ]
}
